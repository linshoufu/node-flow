{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Node Flow：安装依赖",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/.codex/run.sh",
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/bin:${workspaceFolder}/.venv/bin:${env:PATH}",
          "NO_PROXY": "localhost,127.0.0.1,::1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Node Flow：启动前端",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/.codex/run.sh",
        "dev:web"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/bin:${workspaceFolder}/.venv/bin:${env:PATH}",
          "NO_PROXY": "localhost,127.0.0.1,::1"
