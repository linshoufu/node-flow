      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Node Flow：启动后端",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/.codex/run.sh",
